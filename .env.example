# Copy this file to .env and fill in local values. Never commit .env.

# Configuration name: development, testing, or production
FLASK_CONFIG=development

# Required when FLASK_CONFIG=production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite path (relative paths live in the instance/ folder) or a database URL
DATABASE_URL=sqlite:///myconomy.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Production: set FLASK_CONFIG=production, a real SECRET_KEY, and serve over HTTPS.
